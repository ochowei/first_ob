views:
  - type: table
    name: Project
    filters:
      and:
        - note["in-progress"] == true
        - archived != true
        - or:
            - file.folder == "V2/600 Project"
    order:
      - file.name
      - file.folder
      - priority
    sort:
      - property: priority
        direction: DESC
    columnSize:
      file.name: 492
  - type: table
    name: Exploration
    filters:
      and:
        - note["in-progress"] == true
        - archived != true
        - or:
            - file.folder == "V2/400 Exploration"
    order:
      - file.name
      - file.folder
      - priority
    sort:
      - property: priority
        direction: DESC
    columnSize:
      file.name: 492
  - type: table
    name: Watchlist
    filters:
      and:
        - note["in-progress"] == true
        - archived != true
        - or:
            - file.folder == "V2/200 Watchlist"
    order:
      - file.name
      - file.folder
      - priority
    sort:
      - property: priority
        direction: DESC
    columnSize:
      file.name: 492
